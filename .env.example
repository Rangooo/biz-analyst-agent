# ===== LLM Provider API Keys（至少配置一个；DeepSeek 为主分析，WeLM/OpenAI 可做红队或备用）=====
APP_MODE=local
# local/dev/demo: allow runtime key entry and local custom providers.
# server/prod/production: disable runtime writes by default; configure via env.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_RUNTIME_CONFIG=true
ALLOW_CUSTOM_PROVIDER=true
ALLOW_ENV_PERSIST=false
# In APP_MODE=server, custom provider hosts must be explicitly allowlisted.
# CUSTOM_PROVIDER_HOST_ALLOWLIST=llm-proxy.example.com

DEEPSEEK_API_KEY=
WELM_API_KEY=
OPENAI_API_KEY=

# ===== 自定义/内网 LLM 代理（可选）=====
# 如果你使用内网代理或自部署端点（如 vLLM/Ollama），在 providers.local.yaml 配置 provider。
# 非标准鉴权头（如 Platform-User/Token/Business）请在此填对应的环境变量名。
# 示例（实际变量名按你 providers.local.yaml 中 extra_headers 的定义填写）：
# CUSTOM_PROXY_API_KEY=test
# CUSTOM_PROXY_PLATFORM_USER=
# CUSTOM_PROXY_USER_TOKEN=
# CUSTOM_PROXY_BUSINESS=

# ===== 搜索 API =====
# 搜索源架构：Exa(主搜索,免费) → Tavily(补充,有免费额度) → Serper(补充备用)
#
# 【推荐】Exa 语义搜索（免费、无需 API Key、中英混合友好）
# 通过 mcporter 调用 Exa MCP server。安装方式（mcporter ≥0.9）：
#   npm install -g mcporter                                          # 须全局，后端用 shutil.which 探测
#   mcporter config add exa https://mcp.exa.ai/mcp                   # 注册 Exa 远程 MCP server
#   （后端从非项目目录启动时，建议写系统级：mcporter --config ~/.mcporter/mcporter.json config add exa ...）
# 安装后自动生效，无需在此填 Key。未安装 mcporter 时自动降级到 Tavily/Serper。
#
# Tavily: https://tavily.com 注册可得免费额度（结构化搜索，作为 Exa 的补充）
EXA_API_KEY=
TAVILY_API_KEY=
# 可选备用：Serper https://serper.dev
SERPER_API_KEY=

# ===== SEC EDGAR 要求请求带 User-Agent（格式：名称 邮箱）=====
SEC_USER_AGENT=biz-analyst-agent your-email@example.com

# ===== 可选金融数据源（未配置时自动跳过，不影响核心功能）=====
# Optional semantic retrieval. Disabled by default to keep quick tests offline.
ENABLE_SEMANTIC_INDEX=false
# iFinD 同花顺金融数据（需安装对应 skill 或手动指定脚本路径）
# IFIND_SCRIPT=/path/to/ifind/call-node.js
# Wind MCP / AIFin Market（https://aifinmarket.wind.com.cn/#/home，每日约1000次）
# 推荐：先在 AIFin Market 复制 MCP 配置并接入 mcporter/Cursor/Trae 等客户端。
# 然后指定 mcporter 中的 server/tool 与参数名：
# WIND_MCP_SERVER=wind
# WIND_MCP_TOOL=financial_docs.get_financial_news
# WIND_MCP_QUERY_ARG=question
# WIND_MCP_LIMIT_ARG=top_k
# 可选：若 tool 需要 kind 参数，填 WIND_MCP_KIND_ARG=kind
#
# 逃生口：若你有一条「一次性执行并直接返回 JSON」的 CLI，才使用 WIND_MCP_COMMAND。
# 命令模板支持 {query}/{kind}/{max_results} 占位；推荐 JSON 数组，避免 Windows 路径/空格转义问题：
# WIND_MCP_COMMAND=["wind-mcp","search","--query","{query}","--kind","{kind}","--limit","{max_results}"]
# 或：
# WIND_MCP_COMMAND=wind-mcp search --query "{query}" --kind "{kind}" --limit {max_results}
# NeoData 金融数据 API（需安装对应 skill 或手动指定脚本路径）
# NEODATA_SCRIPT=/path/to/neodata/query.py
# MX_FinSearch 东方财富免费资讯检索（需安装对应 skill 或手动指定脚本路径）
# MXFINSEARCH_SCRIPT=/path/to/get_data.py
# Playwright 动态网页抓取（处理 JS 渲染页面，未配置时仅用 httpx 直取）
# PW_SCRAPER_SCRIPT=/path/to/playwright-simple.js
